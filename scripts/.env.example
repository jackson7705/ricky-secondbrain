# =============================================================================
#  Ricky — environment configuration
#  Copy this file to `.env` (same folder) and fill in YOUR values.
#  `.env` is git-ignored — your secrets never leave this machine.
#  Every teammate runs their OWN independent Ricky: own accounts, own keys.
#  Full walkthrough: .claude/ONBOARDING.md
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
#  1. OWNER IDENTITY  (who this Ricky belongs to)  — REQUIRED
# ─────────────────────────────────────────────────────────────────────────────
# Your name — used in prompts and notifications.
OWNER_NAME=
# Your mobile number Ricky texts/reads on iMessage — digits only, incl. country
# code (e.g. 16185582424). Autonomous jobs message this number.
OWNER_PHONE=
# Your own email addresses (comma-separated) — lets Ricky tell YOUR action items
# and threads apart from other people's.
OWNER_EMAILS=
# OPTIONAL — override the BlueBubbles chat GUID directly (e.g. for a group chat).
# Leave blank to auto-build "any;-;+<OWNER_PHONE>".
# OWNER_IMESSAGE_GUID=
# OPTIONAL — namespace for your launchd jobs + log dir. Defaults to
# "<macuser>secondbrain" (jobs become com.<slug>.<job>, logs to /tmp/<slug>).
# OWNER_LAUNCHD_SLUG=

# ─────────────────────────────────────────────────────────────────────────────
#  2. CHAT SURFACE — how you talk to Ricky.  PICK AT LEAST ONE.
#     Configure several and Ricky listens on all of them at once.
#     ⚠️ BlueBubbles/iMessage only works on a Mac. On Windows/Linux (or if you
#        just prefer it) use Telegram or Discord — both work on any OS.
# ─────────────────────────────────────────────────────────────────────────────

# --- Option A: iMessage via BlueBubbles (Mac only) ---
# Install the BlueBubbles Server on THIS Mac (https://bluebubbles.app), sign it
# into iMessage, set a server password, enable the Private API.
BLUEBUBBLES_URL=http://localhost:1234
BLUEBUBBLES_PASSWORD=
# Handles allowed to command Ricky (your phone/email), comma-separated.
IMESSAGE_ALLOWED_ADDRESSES=
BLUEBUBBLES_POLL_INTERVAL=3

# --- Option B: Telegram (any OS, easiest) ---
# 1) Message @BotFather → /newbot → copy the token.  2) Message your new bot.
# 3) Get your numeric user id from @userinfobot.  Only listed ids can command it.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

# --- Option C: Discord (any OS) ---
# 1) https://discord.com/developers → New Application → Bot → copy token.
# 2) Enable "MESSAGE CONTENT INTENT" under Bot settings.
# 3) Invite the bot to a server, or just DM it. Get your user id (enable
#    Developer Mode → right-click yourself → Copy User ID).
# Needs the discord extra:  cd .claude/scripts && uv sync --extra discord
DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_USER_IDS=

# --- Option D: Slack (any OS) --- see section 11 for SLACK_BOT_TOKEN / SLACK_APP_TOKEN.

# --- Where autonomous jobs send one-way pings (loose_ends / fathom / eod) ---
# One of: bluebubbles | telegram | discord | slack. Leave blank to auto-pick the
# first configured surface (bluebubbles first, for existing Mac installs).
OWNER_NOTIFY_CHANNEL=
# Telegram target chat id (usually same as your user id above).
OWNER_TELEGRAM_CHAT_ID=
# Discord one-way notifications: a channel Webhook URL (Server → Integrations →
# Webhooks → New). Simpler than the bot for pings.
OWNER_DISCORD_WEBHOOK_URL=
# Slack channel/DM id for notifications (uses SLACK_BOT_TOKEN).
OWNER_SLACK_NOTIFY_CHANNEL=

# ─────────────────────────────────────────────────────────────────────────────
#  3. GOOGLE  (Gmail + Calendar + Drive + Sheets/Docs)  — REQUIRED
# ─────────────────────────────────────────────────────────────────────────────
# OAuth setup (see notes at bottom). After creating google_credentials.json:
#   cd .claude/scripts && uv run python setup_auth.py --account <profile>
# DEFAULT_GOOGLE_ACCOUNT picks the profile used when no --account is passed.
DEFAULT_GOOGLE_ACCOUNT=
# Calendar Ricky schedules on ("primary" or a specific calendar id).
GOOGLE_CALENDAR_ID=primary
# Google Drive folder where Ricky uploads briefings/deliverables (the folder id
# from the Drive URL). Make sure your Google account can write to it.
DRIVE_BRIEFINGS_FOLDER_ID=

# ─────────────────────────────────────────────────────────────────────────────
#  4. CLICKUP  (task capture)  — REQUIRED for loose_ends / fathom_sweep
# ─────────────────────────────────────────────────────────────────────────────
# Personal API token: ClickUp → Settings → Apps → Generate (starts with pk_).
CLICKUP_API_TOKEN=
CLICKUP_WORKSPACE_ID=
# Your ClickUp user id (numeric) — new tasks are assigned to you.
CLICKUP_OWNER_UID=
# The list id where auto-captured to-dos land (your "Inbox" list).
CLICKUP_INBOX_LIST_ID=
# OPTIONAL — extra list ids to monitor (comma-separated).
# CLICKUP_LIST_IDS=

# ─────────────────────────────────────────────────────────────────────────────
#  5. FATHOM  (meeting action items)  — OPTIONAL (enables fathom_sweep)
# ─────────────────────────────────────────────────────────────────────────────
# REST API key from https://fathom.video → Settings → API.
FATHOM_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
#  6. REDIS IRIS  (structured memory / MCP query tools)  — OPTIONAL
# ─────────────────────────────────────────────────────────────────────────────
REDIS_URL=
CONTEXT_RETRIEVER_AGENT_KEY=
CONTEXT_RETRIEVER_MCP_URL=

# ─────────────────────────────────────────────────────────────────────────────
#  7. APIFY  (web scraping MCP)  — OPTIONAL
#  NOTE: also referenced by ~/.claude.json (see ONBOARDING.md → MCP config).
# ─────────────────────────────────────────────────────────────────────────────
APIFY_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
#  8. CHAT ENGINE limits
# ─────────────────────────────────────────────────────────────────────────────
CHAT_MAX_TURNS=500
CHAT_MAX_BUDGET_USD=100.0

# ─────────────────────────────────────────────────────────────────────────────
#  9. HEARTBEAT / SCHEDULE
# ─────────────────────────────────────────────────────────────────────────────
HEARTBEAT_INTERVAL_MINUTES=30
HEARTBEAT_ACTIVE_HOURS_START=08:00
HEARTBEAT_ACTIVE_HOURS_END=22:00
HEARTBEAT_TIMEZONE=America/Chicago
REFLECTION_HOUR=8

# ─────────────────────────────────────────────────────────────────────────────
#  10. AUTH  (Claude)
#  Claude Agent SDK uses your Claude Code CLI login automatically — just run
#  `claude` once and sign in. Only set these to override:
# ─────────────────────────────────────────────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_CODE_OAUTH_TOKEN=...

# ─────────────────────────────────────────────────────────────────────────────
#  11. OPTIONAL EXTRAS  (LinkedIn / Ahrefs / Slack / Circle / Postgres)
# ─────────────────────────────────────────────────────────────────────────────
# DATABASE_URL=postgresql://secondbrain:changeme@localhost:5432/secondbrain
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# AHREFS_API_TOKEN=

# --- Slack (only if you want the Slack chat surface in addition to iMessage) ---
# Bot token (xoxb-, scopes: channels:read, channels:history, chat:write,
# chat:write.public, users:read) + App token (xapp-, Socket Mode).
# SLACK_BOT_TOKEN=
# SLACK_APP_TOKEN=
# SLACK_OWNER_USER_ID=
# SLACK_NOTIFICATION_CHANNEL=
# SLACK_MONITORED_CHANNELS=

# --- Circle (community platform) ---
# CIRCLE_ADMIN_TOKEN=
# CIRCLE_HEADLESS_TOKEN=
# CIRCLE_MEMBER_EMAIL=
# CIRCLE_COMMUNITY_MEMBER_ID=

# =============================================================================
#  SETUP NOTES
# =============================================================================
# GOOGLE OAUTH
#   1. https://console.cloud.google.com → create/select a project
#   2. Enable: Gmail API, Google Calendar API, Google Drive API, Sheets API
#   3. OAuth consent screen → External → fill in → PUBLISH (avoids 7-day expiry)
#   4. Credentials → Create → OAuth client ID → Desktop app → download JSON
#   5. Save as .claude/scripts/integrations/google_credentials.json
#   6. cd .claude/scripts && uv run python setup_auth.py --account <profile>
#   Re-auth after scope changes: delete the google_token_<profile>.json, re-run.
#
# CLICKUP IDs
#   Owner uid + list id: open the ClickUp list in a browser; the list id is the
#   number in the URL. Owner uid: ClickUp API `GET /user`, or ask Ricky to fetch.
