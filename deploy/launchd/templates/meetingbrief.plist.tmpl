<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>__LABEL_PREFIX__.meetingbrief</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <string>PROJECT_DIR="__PROJECT_DIR__"; SKILL_DIR="$PROJECT_DIR/.claude/skills/meeting-concierge"; SCRIPTS_DIR="$PROJECT_DIR/.claude/scripts"; LOG_DIR="__LOG_DIR__"; mkdir -p "$LOG_DIR"; cd "$SKILL_DIR"; export CLAUDE_PROJECT_DIR="$PROJECT_DIR" PYTHONUNBUFFERED=1; /opt/homebrew/bin/uv run --project "$SCRIPTS_DIR" python -u "$SKILL_DIR/main.py" brief &gt;&gt; "$LOG_DIR/meetingbrief.log" 2&gt;&amp;1</string>
    </array>
    <key>StartInterval</key>
    <integer>300</integer>
    <key>StandardOutPath</key>
    <string>__LOG_DIR__/meetingbrief-stdout.log</string>
    <key>StandardErrorPath</key>
    <string>__LOG_DIR__/meetingbrief-stderr.log</string>
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
