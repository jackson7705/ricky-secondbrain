<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>__LABEL_PREFIX__.heartbeat</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <string>PROJECT_DIR="__PROJECT_DIR__"; SCRIPTS_DIR="$PROJECT_DIR/.claude/scripts"; LOG_DIR="__LOG_DIR__"; mkdir -p "$LOG_DIR"; cd "$SCRIPTS_DIR"; export CLAUDE_PROJECT_DIR="$PROJECT_DIR"; PYTHON="$SCRIPTS_DIR/.venv/bin/python3"; "$PYTHON" "$SCRIPTS_DIR/heartbeat.py" >> "$LOG_DIR/heartbeat.log" 2>&amp;1</string>
    </array>
    <key>StartInterval</key>
    <integer>1800</integer>
    <key>StandardOutPath</key>
    <string>__LOG_DIR__/heartbeat-stdout.log</string>
    <key>StandardErrorPath</key>
    <string>__LOG_DIR__/heartbeat-stderr.log</string>
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
