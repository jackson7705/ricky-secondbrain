<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>__LABEL_PREFIX__.weeklycontent</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <string>PROJECT_DIR="__PROJECT_DIR__"; SCRIPTS_DIR="$PROJECT_DIR/.claude/scripts"; LOG_DIR="__LOG_DIR__"; mkdir -p "$LOG_DIR"; cd "$SCRIPTS_DIR"; export CLAUDE_PROJECT_DIR="$PROJECT_DIR"; PATH="$PATH:/opt/homebrew/bin:__HOME__/.local/bin"; PYTHON="$SCRIPTS_DIR/.venv/bin/python3"; "$PYTHON" "$SCRIPTS_DIR/weekly_content.py" >> "$LOG_DIR/weekly-content.log" 2>&amp;1</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>0</integer>
        <key>Hour</key>
        <integer>8</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>__LOG_DIR__/weekly-content-stdout.log</string>
    <key>StandardErrorPath</key>
    <string>__LOG_DIR__/weekly-content-stderr.log</string>
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
